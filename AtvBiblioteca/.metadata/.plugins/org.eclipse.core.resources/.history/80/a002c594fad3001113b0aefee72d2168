package fag.Objetos;

import java.util.ArrayList;
import java.util.List;

public class Pessoa {

	private String nome;
	private List<Livro> filmesLocados;
	
	public Pessoa() {
		this.filmesLocados = new ArrayList<Livro>();
	}

	public Pessoa(String nome) {
		this.nome = nome;
		this.filmesLocados = new ArrayList<Livro>();
	}
	
	public String getNome() {
		return nome;
	}
	public void setNome(String nome) {
		this.nome = nome;
	}
	public List<Livro> getFilmesLocados() {
		return filmesLocados;
	}
	public void setFilmesLocados(List<livro> filmesLocados) {
		this.filmesLocados = filmesLocados;
	}
	
	
	
}