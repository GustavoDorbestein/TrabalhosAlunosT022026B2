package fag;

import java.util.ArrayList;
import java.util.List;
import java.util.Scanner;

import fagObjetos.Produto;


public class Principal {

	static Scanner scan = new Scanner(System.in);
	static List<Produto> listaProdutos = new  ArrayList<Produto>();

	public static void main(String[] args) {
		System.out.println("-----------Sistema iniciado-----------");
		mostrarMenu();
	}

	private static void mostrarMenu() {
		int escolhaUsuario = 0;
		do {

			System.out.println("---------Selecione uma das opções---------");
			System.out.println("1- Cadastrar produto ");
			System.out.println("2- Listar todos produtos ");
			System.out.println("3- Buscar ID do produto ");
			System.out.println("4- Atulizar produto");
			System.out.println("5- Excluir");
			System.out.println("0- Sair");
			escolhaUsuario = scan.nextInt();
			scan.nextLine();
			validarEscolha(escolhaUsuario);

		} while(escolhaUsuario != 0);
	}

	private static void validarEscolha(int escolhaUsuario) {
		switch (escolhaUsuario) {
		case 0: {
			System.out.println("Sistema encerrado. Obrigado por utilizar!");
			break;
		}
		case 1: {
			cadastrarProduto();
			break;
		}
		case 2: {
			listaProdutos();
			break;
		}
		case 3: {
			buscarProduto();
			break;
		}
		case 4: {

			break;
		}
		case 5: {

			break;
		}

		default:
			System.out.println("Informe um valor válido!");
		}
	}

	private static void buscarProduto() {
		if (listaProdutos.size() == 0) {
			System.out.println("Nenhum produto cadastrado!");
			return;
		}

	}

	private static void listaProdutos() {
		if (listaProdutos.size() == 0) {
			System.out.println("Nenhum produto cadastrado!");
			return;
		}
		System.out.println("--------Lista de produtos--------");
		for (int i=0; i<listaProdutos.size(); i++) {
			exibirProduto(listaProdutos.get(i));
		}
	}

	private static void cadastrarProduto() {

		Produto produto = new Produto();

		System.out.println("Informe o nome do produto: ");
		produto.setNome(scan.nextLine());

		System.out.println("Informe o preço do produto: ");
		produto.setPreco(scan.nextDouble());
		scan.nextLine();

		System.out.println("Informe a quantidade do produto: ");
		produto.setQuantidade(scan.nextInt());
		scan.nextLine();

		listaProdutos.add(produto);
		System.out.println("Produto cadastrado com sucesso! ID: " + produto.getId());
	}

	private static void exibirProduto(Produto produto) {
		System.out.printf("ID: %d | Nome: %s | Preço: R$ %.2f | Qtd: %d\n",
				produto.getId(), produto.getNome(), produto.getPreco(), produto.getQuantidade());
	}
}




