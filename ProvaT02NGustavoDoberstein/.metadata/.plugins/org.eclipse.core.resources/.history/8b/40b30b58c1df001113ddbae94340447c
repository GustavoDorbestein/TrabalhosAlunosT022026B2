package fagProva;

import java.util.ArrayList;
import java.util.List;
import java.util.Scanner;
import fagProva.Times;

public class Campeonatoum {

	static Scanner scan = new Scanner(System.in);
	static List<Times> tabelaBrasileiro = new ArrayList<Times>();

	public static void main(String[] args) {
		mostrarMenu();
	}


	private static void mostrarMenu() {
		int escolhaUsuario =0;
		do {
			System.out.println("------------Selecione uma das opções-----------------");
			System.out.println("1- Cadastrar time");
			System.out.println("2- Listar Times");
			System.out.println("3- Registrar partida");
			System.out.println("4- exibir classificação");
			System.out.println("0- Saída");
			escolhaUsuario = scan.nextInt();
			scan.nextLine();
			validarEscolha(escolhaUsuario);
		}while (escolhaUsuario != 0);


	}


	private static void validarEscolha(int escolhaUsuario) {
		switch (escolhaUsuario) {
		case 0: {
			System.out.println("Obrigado por utilizar o sistema!");
			break;
		}
		case 1: {
			cadastrarTime();
			break;
		}
		case 2: {

			break;
		}
		case 3: {

			break;
		}
		case 4: {

			break;
		}
		default:
			throw new IllegalArgumentException("Unexpected value: " + escolhaUsuario);
		}		
	}


	Times buscarTime(String nome) {
		for (int i = 0; i < tabelaBrasileiro.size(); i++) {
			if (tabelaBrasileiro.get(i).getNome().equalsIgnoreCase(nome)) {
				return tabelaBrasileiro.get(i);
			}
		}
		return null;
	}

	public static void cadastrarTime() {
		System.out.println("Informe o nome do time: ");
		String nome = scan.nextLine().trim();

		if (nome.isEmpty()) {
			System.out.println("O nome não pode ficar vazio!");
			return;
		}
		if (buscarTime(nome) != null) {
			System.out.println("Já existe um time com esse nome!");
			return;
		}

		tabelaBrasileiro.add(new Times(nome));
		System.out.println("Time cadastrado com sucesso!");
	}

	public void listarTimes() {
		if (tabelaBrasileiro.size() == 0) {
			System.out.println("Nenhum time cadastrado!");
			return;
		}
		for (int i = 0; i < tabelaBrasileiro.size(); i++) {
			System.out.printf("%d) ", i + 1);
			tabelaBrasileiro.get(i).exibirDados();
		}
	}

	public void registrarPartida() {
		if (tabelaBrasileiro.size() < 2) {
			System.out.println("Cadastre pelo menos 2 times para registrar uma partida!");
			return;
		}

		System.out.println("Informe o nome do time mandante: ");
		Times mandante = buscarTime(scan.nextLine());
		if (mandante == null) {
			System.out.println("Time mandante não encontrado!");
			return;
		}

		System.out.println("Informe o nome do time visitante: ");
		Times visitante = buscarTime(scan.nextLine());
		if (visitante == null) {
			System.out.println("Time visitante não encontrado!");
			return;
		}

		if (mandante == visitante) {
			System.out.println("Um time não pode jogar contra ele mesmo!");
			return;
		}

		int golsMandante = lerInteiro("Informe os gols do mandante: ");
		int golsVisitante = lerInteiro("Informe os gols do visitante: ");

		if (golsMandante < 0 || golsVisitante < 0) {
			System.out.println("Não é permitido gols negativos!");
			return;
		}

		mandante.registrarResultado(golsMandante, golsVisitante);
		visitante.registrarResultado(golsVisitante, golsMandante);
		System.out.println("Partida registrada com sucesso!");
	}

	public void exibirClassificacao() {
		if (times.size() == 0) {
			System.out.println("Nenhum time cadastrado!");
			return;
		}

		List<Times> tabela = new ArrayList<Times>(times);

		for (int i = 0; i < tabela.size() - 1; i++) {
			for (int j = 0; j < tabela.size() - 1 - i; j++) {
				Times a = tabela.get(j);
				Times b = tabela.get(j + 1);

				boolean bVemAntes = b.getPontos() > a.getPontos()
						|| (b.getPontos() == a.getPontos() && b.getSaldoGols() > a.getSaldoGols());

				if (bVemAntes) {
					tabela.set(j, b);
					tabela.set(j + 1, a);
				}
			}
		}

		System.out.println("---------Classificação---------");
		System.out.printf("%-5s %-15s %4s %3s %3s %3s %4s\n", "Pos.", "Time", "Pts", "V", "E", "D", "SG");
		for (int i = 0; i < tabela.size(); i++) {
			Times t = tabela.get(i);
			System.out.printf("%-5s %-15s %4d %3d %3d %3d %4d\n", (i + 1) + "º", t.getNome(), t.getPontos(),
					t.getVitorias(), t.getEmpates(), t.getDerrotas(), t.getSaldoGols());
		}
	}
}

